# Copia este archivo como .env y sustituye todos los valores indicados.
# Docker Compose carga .env automáticamente. El archivo local no se versiona.
MYSQL_ROOT_PASSWORD=replace_with_a_strong_local_root_password
DB_USERNAME=rmm_app
DB_PASSWORD=replace_with_a_strong_local_database_password

# Deben coincidir con la identidad rmm-backend de mqtt-users.local.
MQTT_BACKEND_USERNAME=rmm-backend
MQTT_BACKEND_PASSWORD=replace_with_a_strong_local_mqtt_password
MOSQUITTO_CONFIG_FILE=/mosquitto/config/mosquitto.conf
RMM_MQTT_HOST_PORT=1883
RMM_MQTT_PORT=1883
RMM_MQTT_TLS=false

# El primer operador solo se crea cuando operator_accounts está vacía.
OPERATOR_USERNAME=local_admin
OPERATOR_EMAIL=local_admin@example.local
OPERATOR_PASSWORD=replace_with_a_password_of_at_least_12_characters
OPERATOR_FIRST_NAME=Local
OPERATOR_LAST_NAME=Administrator

FRONTEND_URL=http://localhost:4200
BACKEND_BIND_ADDRESS=0.0.0.0
SESSION_COOKIE_SECURE=false
OPERATOR_SESSION_TIMEOUT=30m
SERVICE_TIME_ZONE=Europe/Madrid
DEVICE_EVENT_SIMULATION_ENABLED=true
DEVICE_EVENT_SIMULATION_INITIAL_DELAY_MS=1000
DEVICE_EVENT_SIMULATION_INTERVAL_MS=1000

# Solo para desarrollo local sin servicio de correo. En otros entornos debe ser false.
RMM_APP_AUTO_VERIFY_REGISTRATION=true
